// ─────────────────────────────────────────────────────────────
// WiNILL 임베디드 리소스
//   exe 안에 폰트/아이콘(이미지)을 직접 포함시켜 단일 파일 배포
//   런타임에 FindResource/LoadResource/LockResource 로 접근
//   (BULLET_RAIN.png 원본 복원 — 리소스 재컴파일 강제용 주석 v2)
// ─────────────────────────────────────────────────────────────

#include "resource.h"

// Windows exe / 작업 표시줄 / 탐색기 아이콘
IDI_APP_ICON ICON "Resource\\WiNILL.ico"

// 폰트 폴백 체인 — stb_truetype (InitFromMemory).
//   최신 배포 폰트는 WiNILL/Resource/Font 에서 직접 임베드한다.
FONT_CHAKRA     RCDATA      "Resource\\Font\\ChakraPetch-Regular.ttf"
FONT_ORBIT      RCDATA      "Resource\\Font\\Orbit-Regular.ttf"
FONT_JUA        RCDATA      "Resource\\Font\\Jua-Regular.ttf"
FONT_KOSUGI     RCDATA      "Resource\\Font\\KosugiMaru-Regular.ttf"
FONT_ZCOOL      RCDATA      "Resource\\Font\\ZCOOLQingKeHuangYou-Regular.ttf"

// 배경 마스크 — 외부 Resource/ 폴더 없이도 메뉴 셰이더가 초기화되도록 임베드.
IMAGE_BG_RADIAL RCDATA      "Resource\\bg_radial.png"
IMAGE_BG_LINEAR RCDATA      "Resource\\bg_linear.png"

// 오디오 — miniaudio가 메모리 디코더로 직접 재생한다.
AUDIO_BGM_MAIN  RCDATA      "Resource\\Audio\\bgm_main.mp3"
AUDIO_SFX_SHOOT RCDATA      "Resource\\Audio\\sfx_shoot.wav"
AUDIO_SFX_KILL  RCDATA      "Resource\\Audio\\sfx_kill.wav"
AUDIO_SFX_HURT  RCDATA      "Resource\\Audio\\sfx_hurt.wav"
AUDIO_SFX_DEATH RCDATA      "Resource\\Audio\\sfx_death.wav"

// UI 텍스처 — IconSystem 이 "ICON_<이름>" 으로 로드
ICON_CONFIG_PANEL       RCDATA      "Resource\\Icons\\PanelTexture.png"
ICON_LEFT_GRADIENT      RCDATA      "Resource\\Icons\\LeftGradient.png"
ICON_TITLE_LOGO_A       RCDATA      "Resource\\Icons\\TitleLogoA.png"
ICON_TITLE_LOGO_B       RCDATA      "Resource\\Icons\\TitleLogoB.png"
ICON_CONSTELLATION_LINE RCDATA      "Resource\\Icons\\LineTexture.png"
ICON_CONSTELLATION_CIRCLE RCDATA    "Resource\\Icons\\CircleTexture.png"
ICON_INGAME_CIRCLE      RCDATA      "Resource\\Icons\\InGameCircleTexture.png"

